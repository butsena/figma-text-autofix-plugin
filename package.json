{
  "name": "figma-text-autofix-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:yo-curated && node scripts/build-ui-html.mjs && vite build --watch",
    "build:yo-curated": "node scripts/build-yo-curated.mjs",
    "build:replacements": "node scripts/build-text-replacements.mjs",
    "sync:spell-dictionary": "node scripts/sync-spell-dictionary-bundled.mjs",
    "build": "npm run build:yo-curated && node scripts/build-ui-html.mjs && vite build",
    "build:release": "node scripts/build-analytics.mjs release",
    "test": "npm run build:yo-curated && vitest run",
    "test:watch": "npm run build:yo-curated && vitest",
    "qa:extract-canvas": "node scripts/qa-extract-canvas-items.mjs",
    "qa:sync-canvas": "node scripts/qa-sync-canvas.mjs",
    "build:qa": "node scripts/build-analytics.mjs qa",
    "check:release": "node scripts/check-analytics-release.mjs"
  },
  "dependencies": {
    "nspell": "^2.1.5",
    "pako": "^3.0.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.125.0",
    "@types/pako": "^2.0.4",
    "dictionary-ru": "^3.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.1",
    "vitest": "^3.2.4"
  },
  "version": "0.22.0-t151.1"
}
